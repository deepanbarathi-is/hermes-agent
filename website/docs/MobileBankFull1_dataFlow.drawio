        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: Bank ABC Mobile Banking - Trust Boundaries Only\n---\nflowchart LR\n    subgraph B1[Trust Boundary 1: Customer Device - Untrusted]\n        User[Bank Customer]\n        App[Mobile Banking App]\n    end\n\n    subgraph B2[Trust Boundary 2: Internet and Bank Edge]\n        Gateway[API Gateway]\n    end\n\n    subgraph B3[Trust Boundary 3: Banking Application Zone]\n        Auth[Authentication Service]\n        Balance[Balance Service]\n        Transfer[Funds Transfer Service]\n    end\n\n    subgraph B4[Trust Boundary 4: Authentication Data Zone]\n        LoginDB[(Mobile Login Database)]\n    end\n\n    subgraph B5[Trust Boundary 5: Core Banking Zone - Highly Sensitive]\n        Core[Core Banking System]\n    end\n\n    subgraph B6[Trust Boundary 6: External Identity Dependency]\n        MFA[MFA Provider]\n    end\n\n    User -.-&gt;|Customer interaction| App\n    App -.-&gt;|External API boundary| Gateway\n    Gateway -.-&gt;|Application trust boundary| Auth\n    Gateway -.-&gt;|Application trust boundary| Balance\n    Gateway -.-&gt;|Application trust boundary| Transfer\n    Auth -.-&gt;|Data access boundary| LoginDB\n    Auth -.-&gt;|External provider boundary| MFA\n    Balance -.-&gt;|Financial-system boundary| Core\n    Transfer -.-&gt;|Financial-system boundary| Core\n\n    classDef untrusted fill:#f8cecc,stroke:#b85450\n    classDef edge fill:#ffe6cc,stroke:#d79b00\n    classDef app fill:#dae8fc,stroke:#6c8ebf\n    classDef data fill:#fff2cc,stroke:#d6b656\n    classDef core fill:#e1d5e7,stroke:#9673a6\n    classDef external fill:#d5e8d4,stroke:#82b366\n    class User,App untrusted\n    class Gateway edge\n    class Auth,Balance,Transfer app\n    class LoginDB data\n    class Core core\n    class MFA external&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="27">
